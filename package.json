{
  "name": "calendar-todo-countdown-notes",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "颗秒日事：日历、待办、倒数日和便签一体的本地优先网页应用",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:timetable": "npx --yes tsx src/lib/timetable-import.selftest.ts && npx --yes tsx src/lib/week-grid.selftest.ts",
    "test:server": "node --import tsx --test server/src/*.test.ts",
    "test:sync": "npm run test:server",
    "build:server": "esbuild server/src/listen.ts --bundle --platform=node --format=cjs --outfile=server/dist/index.cjs --legal-comments=none && node scripts/write-bff-loader.mjs",
    "dev:bff": "tsx server/src/listen.ts",
    "deploy:days": "bash scripts/deploy-days.sh",
    "build:android": "tsc -b && vite build --base=./ && npx cap sync android",
    "android:apk": "bash scripts/build-android-apk.sh",
    "android:native:test": "cd android-native && ./gradlew testDebugUnitTest --no-daemon",
    "android:native:release": "bash scripts/build-android-native-release.sh",
    "android:native:deploy": "bash scripts/deploy-android-native-release.sh",
    "build:ios": "tsc -b && vite build && (npx cap add ios || true) && npx cap sync ios",
    "ios:simulator": "npm run build:ios && xcodebuild -workspace ios/App/App.xcworkspace -scheme App -sdk iphonesimulator -configuration Debug -derivedDataPath ios-build CODE_SIGNING_ALLOWED=NO build",
    "desktop:win": "npm run build && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.0.1",
    "@capacitor/browser": "^8.0.1",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@yydsxwh/shared": "github:yydsxwh/shared#v0.5.1",
    "jose": "^6.2.8",
    "leaflet": "^1.9.4",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.18.6",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "electron": "^38.1.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.9",
    "eslint": "^9.11.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "globals": "^15.9.0",
    "lunar-javascript": "^1.7.7",
    "tsx": "^4.20.5",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.7.0",
    "vite": "^5.4.8",
    "vitest": "^2.1.9"
  },
  "build": {
    "appId": "com.yydsxwh.kemiao.days",
    "productName": "颗秒日事",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
